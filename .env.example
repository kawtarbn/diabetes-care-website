# Server Configuration
PORT=3000
NODE_ENV=production

# JWT Secret - CHANGE THIS TO A RANDOM STRING IN PRODUCTION
# Generate a secure random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Configuration
# Comma-separated list of allowed origins (e.g., http://localhost:3000,https://yourdomain.com)
ALLOWED_ORIGINS=*

# Logging Configuration
LOG_LEVEL=info

# Email Configuration (for password reset and email verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@diabetescare.com

# Database Configuration (if migrating to real database)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=diabetes_care
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
